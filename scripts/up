#!/bin/bash
##
## Développé par la team ALL IN APPLI
## Renaud, Fawzy, Ilias, Ambroise, Antoine, Guillaume
##
################################################################
##                                                            ##
##  Scripts de mise à jour de CiviCRM pour les instances web  ##
##                                                            ##
################################################################
shopt -s expand_aliases
################################################################

vhosts="$racine"

source $CUSTOM_DIR/includes/functions_civicrm.sh
source $CUSTOM_DIR/includes/functions.sh

echo -e '\e[93m=============================================\033[0m'
echo "Choisissez l'instance à mettre à jour parmi les domaines disponibles : "
listSite=($(getcvsites | sort))
select instance in "${listSite[@]}"; do break; done
[ -z "$instance" ] && echo -e "${RED}[ ERREUR ]${NC} Instance invalide" && exit 1

echo -e '\e[93m=============================================\033[0m'
echo -e "L'instance cible choisie est : ${GREEN}$instance${NC}"
civi_folder=$(get_site_root $instance)
site_root="$vhosts/$civi_folder"

## --- Détection du CMS ---------------------------------------------------
cms_instance=""
config_dir=""

if [[ -e "$site_root/wp-config.php" ]]; then
    cms_instance="wordpress"
    echo "Installation Wordpress détectée" >&2
elif [[ -e "$site_root/web/sites/default/settings.php" ]]; then
    cms_instance="drupal10+"
    config_dir="web/sites/default"
    echo "Installation Drupal 10+ détectée" >&2
elif [[ -e "$site_root/sites/default/settings.php" ]]; then
    cms_instance="drupal"
    config_dir="sites/default"
    echo "Installation Drupal détectée" >&2
elif [[ -e "$site_root/private/civicrm.settings.php" ]]; then
    cms_instance="standalone"
    config_dir="private"
    echo "Installation Standalone détectée" >&2
elif [[ -e "$site_root/settings.php" ]]; then
    cms_instance="backdrop"
    echo "Installation Backdrop détectée" >&2
fi

if [[ -z "$cms_instance" ]]; then
    echo -e '\e[93m=======================================\033[0m'
    echo -e "${RED}[ ERREUR ]${NC} Aucun CMS valide détecté"
    echo -e '\e[93m=======================================\033[0m'
    exit 1
fi
# --- Cas Drupal 10+ : mise à jour automatisée désactivée pour le moment ---
# (installation pilotée par Composer, trop de cas particuliers par site :
#  contrainte PHP, token GitHub, hooks post-update-cmd tiers, etc.
#  Voir TODO dans functions_civicrm.sh pour réactiver.)
if [[ "$cms_instance" == "drupal10+" ]]; then
    echo -e '\e[93m=======================================\033[0m'
    echo -e "${PURPLE}[ INFO ]${NC} Ce site utilise Drupal 10+ (installation CiviCRM pilotée par Composer)."
    echo "La mise à jour automatique via ce script n'est pas activée pour ce cas."
    echo "Merci de réaliser la montée de version manuellement via Composer."
    echo -e '\e[93m=======================================\033[0m'
    exit 0
fi

## --- Chemins plugins + version CiviCRM selon le CMS ---------------------
case "$cms_instance" in
    wordpress)
        chemin_plugins="$site_root/wp-content/plugins"
        version_file="$chemin_plugins/civicrm/civicrm.php"
        civi_version_actuelle=$(grep "define('CIVICRM_PLUGIN_VERSION'" "$version_file" 2>/dev/null | awk -F"'" '{print $4}')
        label="Wordpress"
        ;;
    "drupal10+")
        # à ajuster si vos modules contrib sont dans web/modules/contrib
        chemin_plugins="$site_root/web/modules/contrib"
        version_file="$site_root/vendor/civicrm/civicrm-core/xml/version.xml"
        civi_version_actuelle=$(grep '<version_no>' "$version_file" 2>/dev/null | awk -F">" '{print $2}' | awk -F"<" '{print $1}')
        label="Drupal 10+"
        ;;
    drupal)
        chemin_plugins="$site_root/sites/all/modules"
        version_file="$chemin_plugins/civicrm/xml/version.xml"
        civi_version_actuelle=$(grep '<version_no>' "$version_file" 2>/dev/null | awk -F">" '{print $2}' | awk -F"<" '{print $1}')
        label="Drupal"
        ;;
    standalone)
        chemin_plugins="$site_root"
        version_file="$chemin_plugins/core/xml/version.xml"
        civi_version_actuelle=$(grep '<version_no>' "$version_file" 2>/dev/null | awk -F">" '{print $2}' | awk -F"<" '{print $1}')
        label="Standalone"
        ;;
    backdrop)
        chemin_plugins="$site_root/modules"
        version_file="$chemin_plugins/civicrm/xml/version.xml"
        civi_version_actuelle=$(grep '<version_no>' "$version_file" 2>/dev/null | awk -F">" '{print $2}' | awk -F"<" '{print $1}')
        label="Backdrop"
        ;;
esac

if [[ ! -e "$chemin_plugins" ]]; then
    echo -e '\e[93m=======================================\033[0m'
    echo -e "${RED}[ ERREUR ]${NC} Dossier CiviCRM introuvable ($chemin_plugins)"
    echo -e '\e[93m=======================================\033[0m'
    exit 1
fi

if [[ -e "$version_file" ]]; then
    echo -e "La version actuelle de CiviCRM est : ${PURPLE}${civi_version_actuelle}${NC} avec ${PURPLE}${label}${NC}"
fi

echo -e '\e[93m=============================================\033[0m'

## --- Récupération de la dernière version stable --------------------------
echo -e "${BLUE}[ INFO ]${NC} récupération de la dernière version stable disponible"
last_version=$(curl -s https://download.civicrm.org/release/ | sed -n 's|.*<a href="/release/\([^"]*\)">.*|\1|p' | sort -V | tail -n1)
cd $vhosts

## --- Choix version --------------------------------------------------------
echo "Quelle version souhaitez-vous ?"
echo -e "Dernière version (d) : ${GREEN}$last_version${NC}"
echo "Personnalisée (p) ?"
echo "Beta (b) ?"
echo "Alpha (a) ?"
read civi_type_version

## --- proposer un backup de bdd  ---
dump_bin="/etc/my_common/scripts_server/scripts/dump" # chemin en dur, garanti de fonctionner peu importe le $PATH au moment de l'exécution.
echo -e '\e[93m=============================================\033[0m'
read -p "Souhaitez-vous faire une sauvegarde de la base de données avant la mise à jour ? (o/N) " do_backup
do_backup=${do_backup:-N}

if [[ "$do_backup" =~ ^[oOyY]$ ]]; then
    # vérifie que le fichier existe et est exécutable avant de l'appeler, pour éviter un plantage silencieux ou une erreur Permission denied en pleine mise à jour.
    ## "$dump_bin" avec guillemets : bonne pratique même si le chemin ne contient pas d'espace ici, pour éviter tout souci si jamais le chemin change plus tard.
    if [[ ! -x "$dump_bin" ]]; then 
        echo -e "${RED}[ ERREUR ]${NC} Script de dump introuvable ou non exécutable : $dump_bin"
        read -p "Voulez-vous continuer la mise à jour SANS backup ? (o/N) " continue_without_backup
        [[ ! "$continue_without_backup" =~ ^[oOyY]$ ]] && echo "Mise à jour annulée." && exit 1
    else
        backup_dir="/var/backups/up"
        mkdir -p "$backup_dir"

        timestamp=$(date +%Y%m%d_%H%M%S)
        backup_file="$backup_dir/${instance}_${civi_version_actuelle:-inconnue}_${timestamp}.sql.gz"

        echo -e ">> Sauvegarde de la base de données en cours vers ${GREEN}${backup_file}${NC} ..."

        cd "$vhosts/$civi_folder" || exit 1
        "$dump_bin" | gzip > "$backup_file"
        backup_status=$?

        if [[ $backup_status -eq 0 && -s "$backup_file" ]]; then
            echo -e ">> Sauvegarde effectuée avec succès (${GREEN}$(du -h "$backup_file" | cut -f1)${NC}) : ${PURPLE}${backup_file}${NC}"
        else
            echo -e '\e[93m=======================================\033[0m'
            echo -e "${RED}[ ERREUR ]${NC} La sauvegarde de la base de données a échoué"
            echo -e '\e[93m=======================================\033[0m'
            rm -f "$backup_file" 2>/dev/null
            read -p "Voulez-vous continuer la mise à jour SANS backup ? (o/N) " continue_without_backup
            [[ ! "$continue_without_backup" =~ ^[oOyY]$ ]] && echo "Mise à jour annulée." && exit 1
        fi
        cd "$vhosts"
    fi
else
    echo ">> Sauvegarde ignorée par l'utilisateur."
fi
echo -e '\e[93m=============================================\033[0m'


case "$civi_type_version" in
    "d")
        civi_version="$last_version"
        set_maintenance_mode "$instance" "$cms_instance"

        if [[ $civi_version =~ ^[0-9]*.[0-9]*.[0-9]*$ ]]; then
            updateCivicrm "$civi_folder" "$civi_version"
        else
            echo -e '\e[93m=======================================\033[0m'
            echo -e '\e[93m\033[31m Version inconnue\033[31m'
            echo -e '\e[93m=======================================\033[0m'
            exit 1
        fi
        ;;

    "p")
        echo "Choisissez la version que vous souhaitez installer (X.YY.Z)  ?"
        read civi_version
        set_maintenance_mode "$instance" "$cms_instance"

        if [[ $civi_version =~ ^[0-9]*.[0-9]*.[0-9]*$ ]]; then
            updateCivicrm "$civi_folder" "$civi_version"
        else
            echo -e '\e[93m=======================================\033[0m'
            echo -e '\e[93m\033[31m Version inconnue\033[31m'
            echo -e '\e[93m=======================================\033[0m'
            exit 1
        fi
        ;;

    "b")
        set_maintenance_mode "$instance" "$cms_instance"
        updateCivicrm "$civi_folder"
        ;;

    "a")
        set_maintenance_mode "$instance" "$cms_instance"
        updateCivicrm "$civi_folder"
        ;;

    *)
        echo "Choix incorrect"
        exit 1
        ;;
esac

cd $racine/$civi_folder
unset_maintenance_mode "$instance" "$cms_instance"
echo " " ; echo -e ">> Mise à jour de la base de données en cours..."
yes | cv updb > /dev/null ; cv flush > /dev/null
echo -e ">> Plesk repair ..." && rep

cd $racine/$civi_folder
echo -e ">> Génération du lien de connexion admin..."
uli admin

echo -e "${BLUE}>> Opération terminée 🚀${NC}"
echo " "

# On écrit le dossier cible dans un fichier temporaire, propre à la session
# du shell APPELANT (identifié via $PPID = pid du shell parent qui a lancé
# ce script). La fonction wrapper "up()" du .bashrc lira ce fichier pour
# faire le "cd" dans le bon shell, puisqu'un "cd" ici ne peut pas persister
# une fois le script terminé (sous-processus).

# Vérifier si on est déjà dans un dossier nommé "httpdocs"
if [[ "${PWD##*/}" == "httpdocs" ]]; then
    # On est déjà dans httpdocs, on utilise directement $PWD
    target_dir="$PWD"
else
    # On construit le chemin normal
    target_dir="$vhosts/$civi_folder/httpdocs"
fi

# Maintenant on vérifie si le dossier existe
if [[ -d "$target_dir" ]]; then
    echo "$target_dir" > "/tmp/.up_last_dir_${PPID}"
else
    echo -e "${RED}[ ATTENTION ]${NC} Dossier httpdocs introuvable pour cette instance ($target_dir)"
fi
